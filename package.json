{
  "name": "logseq-docx-export",
  "version": "0.1.0",
  "description": "Export Logseq pages to .docx files without Pandoc. No telemetry.",
  "main": "dist/index.html",
  "logseq": {
    "id": "logseq-docx-export",
    "title": "DOCX Export",
    "icon": "./icon.png"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "package": "node scripts/package.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@logseq/libs": "0.2.12",
    "docx": "9.8.1",
    "jszip": "3.10.2"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  }
}
